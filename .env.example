APP_NAME=rag-multi-agent-intelligence-engine
APP_ENV=local
LOG_LEVEL=INFO

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents

OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL_FAST=mistral:7b
CHAT_MODEL_REASONING=llama3.1:8b
CHAT_MODEL_STRUCTURED=llama3.1:8b

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=900
CHUNK_OVERLAP=120
TOP_K=6
RETRIEVE_K=20
MAX_CONTEXT_TOKENS=6000

RERANKER_MODE=cross_encoder
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

ENABLE_FEEDBACK_LOOP=true
GROUNDING_THRESHOLD=0.6
MAX_RETRY_ITERATIONS=1

RETRIEVAL_MODE=hybrid
BM25_INDEX_PATH=data/processed/bm25_index.pkl
RRF_K=60

EVAL_BASELINE_GROUNDING=0.0

LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=rag-multi-agent-engine
LANGCHAIN_API_KEY=

